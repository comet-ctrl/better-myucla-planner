{
  "name": "better-myucla",
  "version": "0.18.6",
  "private": true,
  "description": "A local-only, safety-first MyUCLA Class Planner enhancement.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "node harness/run.mjs",
    "test:search-layout": "node harness/verify-native-search-layout.mjs",
    "test:result-layout": "node harness/verify-native-result-layout.mjs",
    "test:empty-plan": "node harness/verify-empty-plan-workspace.mjs",
    "test:details": "node harness/verify-native-detail-layout.mjs",
    "test:optimizer": "node harness/verify-optimizer-workspace.mjs",
    "test:plan-actions": "node harness/verify-plan-actions.mjs",
    "test:module-controls": "node harness/verify-module-controls.mjs",
    "test:finals-controls": "node harness/verify-finals-controls.mjs",
    "test:course-controls": "node harness/verify-course-controls.mjs",
    "test:course-detail-actions": "node harness/verify-course-detail-actions.mjs",
    "test:panel-layout": "node harness/verify-panel-layout.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "preview:verify": "node harness/verify-preview.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astro-wen/better-myucla-planner.git"
  },
  "license": "MIT"
}
